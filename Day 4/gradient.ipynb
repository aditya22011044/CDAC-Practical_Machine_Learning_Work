   "source": [
    "import numpy as np\n",
    "\n",
    "X = np.array([1, 2])\n",
    "y = np.array([2, 4])\n",
    "m = 0.0\n",
    "alpha = 0.1\n",
    "\n",
    "for i in range(6):\n",
    "    y_pred = m * X\n",
    "    mse = np.mean((y - y_pred)**2)\n",
    "    gradient = 2*np.mean(X*(y_pred-y))\n",
    "    print(i, round(m, 4), round(mse, 4))\n",
    "    m = m - alpha * gradient\n"
   ]
  }
 ],
